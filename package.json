{
	"name": "mindmap-studio",
	"version": "0.1.3",
	"description": "Mind map rendering for Markdown in Obsidian: edit .mindmap.md as a mind map with Markdown outline round-trip and Obsidian-native links/images.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings 0",
		"lint:css": "stylelint \"**/*.css\"",
		"check:dead-code": "knip --include files,exports,types",
		"check:release": "node scripts/check-release-metadata.mjs",
		"verify:visual": "node scripts/verify-visual.mjs"
	},
	"keywords": [
		"obsidian",
		"mind-map",
		"simple-mind-map"
	],
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WinterMosquito/Obsidian-Mindmap-Studio.git"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@vitest/coverage-v8": "^3.2.7",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"knip": "^6.36.0",
		"obsidian": "^1.13.1",
		"stylelint": "^17.15.0",
		"stylelint-no-unsupported-browser-features": "^8.1.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.7"
	}
}
